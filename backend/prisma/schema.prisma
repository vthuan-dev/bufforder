generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  phoneNumber       String    @unique
  fullName          String
  email             String?   @unique
  password          String
  vipLevel          String    @default("vip-0")
  totalDeposited    Float     @default(0)
  balance           Float     @default(0)
  freezeBalance     Float     @default(0)
  commission        Float     @default(0)
  isActive          Boolean   @default(true)
  lastSeenAt        DateTime?
  inviteCodeUsed    String?
  
  commissionConfig  Json?     @default("{\"perOrderAmount\": null, \"dailyTarget\": null, \"baseRate\": null, \"dailyProfitMode\": \"fixed\"}")
  dailyEarnings     Json?     @default("{\"dateKey\": null, \"totalCommission\": 0, \"ordersCount\": 0, \"mode\": \"fixed\", \"targetTotal\": 0}")

  addresses         Address[]
  bankCards         BankCard[]
  orders            Order[]
  depositRequests   DepositRequest[] @relation("UserDeposits")
  withdrawalRequests WithdrawalRequest[]
  chatThreads       ChatThread[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([phoneNumber])
  @@index([fullName])
  @@map("user")
}

model Address {
  id            String  @id @default(cuid())
  userId        String
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName      String
  phoneNumber   String
  addressLine1  String
  city          String
  postalCode    String
  isDefault     Boolean @default(false)

  @@index([userId])
  @@map("address")
}

model BankCard {
  id            String  @id @default(cuid())
  userId        String
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankName      String
  cardNumber    String
  accountName   String
  isDefault     Boolean @default(false)

  @@index([userId])
  @@map("bankcard")
}

model Order {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  clientRequestId  String?
  orderNumber      String    @unique
  productId        Int
  productName      String
  productPrice     Float
  commissionRate   Float
  commissionAmount Float
  brand            String?
  category         String?
  image            String?   @db.Text
  status           String    @default("pending")
  completedAt      DateTime?
  orderDate        DateTime  @default(now())

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, clientRequestId])
  @@index([userId, orderDate])
  @@index([status])
  @@map("order")
}

model Admin {
  id            String    @id @default(cuid())
  username      String    @unique
  fullName      String?   @default("")
  email         String    @unique
  phoneNumber   String?   @default("")
  password      String
  role          String    @default("admin")
  isActive      Boolean   @default(true)
  lastLogin     DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("admin")
}

model ChatThread {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  userIp           String?       @default("")
  lastMessageAt    DateTime      @default(now())
  lastMessageText  String?       @db.Text
  unreadForAdmin   Int           @default(0)
  unreadForUser    Int           @default(0)
  status           String        @default("open")
  messages         ChatMessage[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId, lastMessageAt])
  @@index([lastMessageAt])
  @@map("chatthread")
}

model ChatMessage {
  id                String     @id @default(cuid())
  threadId          String
  thread            ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderType        String
  senderId          String
  text              String?    @default("") @db.Text
  imageUrl          String?    @default("") @db.Text
  readByAdmin       Boolean    @default(false)
  readByUser        Boolean    @default(false)
  isDeletedForUser  Boolean    @default(false)
  deletedForUserAt  DateTime?
  isDeletedForAdmin Boolean    @default(false)
  deletedForAdminAt DateTime?

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([threadId])
  @@map("chatmessage")
}

model DepositRequest {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation("UserDeposits", fields: [userId], references: [id])
  amount          Float
  status          String    @default("pending")
  requestDate     DateTime  @default(now())
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?   @db.Text
  notes           String?   @db.Text

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, status])
  @@index([status, requestDate])
  @@map("depositrequest")
}

model WithdrawalRequest {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  amount          Float
  bankCardId      String
  status          String    @default("pending")
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?   @db.Text
  notes           String?   @db.Text
  requestDate     DateTime  @default(now())

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, status])
  @@index([status, requestDate])
  @@map("withdrawalrequest")
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  brand       String
  category    String
  price       Float
  image       String?   @db.Text
  isActive    Boolean   @default(true)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([category])
  @@index([isActive])
  @@map("product")
}
